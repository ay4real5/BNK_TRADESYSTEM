APP_ENV=dev
TIMEZONE=Europe/London

TELEGRAM_BOT_TOKEN=xxx
TELEGRAM_ADMIN_CHAT_IDS=12345,67890
TELEGRAM_PIN=1234

SYMBOLS=XAUUSD,XAGUSD
ENTRY_TF=15m
BIAS_TF=1h

RISK_PER_TRADE_PCT=0.5
MAX_TRADES_PER_DAY=1
MAX_LOSSES_PER_DAY=1
DAILY_DD_CAP_PCT=2.0
COOLDOWN_MIN_AFTER_LOSS=180

MODE=assist   # assist|paper|live

# cTrader (fill in later when live trading is ready)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=

# API (optional FastAPI server)
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite:///data/trading.db
